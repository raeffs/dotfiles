#!/usr/bin/env bash
# Starts the win11 VM if it is not running, then opens Looking Glass.
# Closing Looking Glass does not shut the VM down.
set -euo pipefail

export LIBVIRT_DEFAULT_URI="qemu:///system"
domain="win11"

if [[ "$(virsh domstate "$domain")" != "running" ]]; then
    virsh start "$domain"
fi
# Gives up after 30 s: a VM that stops again right after its start must not
# leave this script waiting forever.
for _ in $(seq 60); do
    if [[ "$(virsh domstate "$domain")" == "running" ]]; then
        exec /usr/local/bin/looking-glass-client
    fi
    sleep 0.5
done

echo "lightroom: $domain did not reach the running state" >&2
exit 1
